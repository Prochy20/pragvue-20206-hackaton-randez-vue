# Postgres from docker-compose.yml
NUXT_DATABASE_URL=postgres://icebreaker:icebreaker@localhost:5432/icebreaker
# Session cookie encryption, at least 32 characters
NUXT_SESSION_PASSWORD=
NUXT_ANTHROPIC_API_KEY=
# Optional public origin for links and the wall QR (behind a proxy)
NUXT_PUBLIC_SITE_URL=
# Optional: enables /reset-password (forgot password without email); keep it secret, clear it when not needed
NUXT_PASSWORD_RESET_KEY=
